DJANGO_SETTINGS_MODULE=config.settings_dev
DJANGO_SECRET_KEY=dev-please-change
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
